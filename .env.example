# Copy to .env and edit. The pipeline runs with ZERO of these set (mock backend).

# Which VLM backend to use: "mock" (default, deterministic, no network) or "openai".
VLM_BACKEND=mock

# Model id passed to the OpenAI-compatible endpoint.
# Examples: gpt-4o, gpt-4o-mini, gemini-1.5-pro, qwen-vl-max
VLM_MODEL=gpt-4o-mini

# OpenAI-compatible base URL. Leave blank for api.openai.com.
# Gemini OpenAI-compat: https://generativelanguage.googleapis.com/v1beta/openai/
# Qwen (DashScope):     https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_BASE_URL=

# Only needed when VLM_BACKEND=openai.
OPENAI_API_KEY=

# Pipeline knobs.
MAX_FRAMES=120
VLM_CONCURRENCY=8
VLM_TEMPERATURE=0
VLM_MAX_RETRIES=3
DEDUP_THRESHOLD=0.98

# Paths (relative to repo root unless absolute).
CACHE_DIR=out/cache
DATA_DIR=data
OUT_DIR=out
